{
  "name": "@xi4z/dsh-utils",
  "version": "0.6.0",
  "description": "DeepSeek Harness utility bundle: a patch-only package that assembles four independently published components — the utils-agents preset/skill panel (nested SKILL.md discovery, model visibilities, skills, repositories and AGENTS.md), an unattended approval gate, session notifications, and the shared browser UI that configures every row.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-panel",
    "markdown",
    "agents-md",
    "utils-agents",
    "skill-discovery",
    "approval",
    "unattended",
    "notify",
    "gotify",
    "qq",
    "multi-device"
  ],
  "license": "MIT",
  "author": "xi4z",
  "homepage": "https://github.com/xi4z/dsh-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xi4z/dsh-utils.git"
  },
  "bugs": {
    "url": "https://github.com/xi4z/dsh-utils/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm -r --filter \"./packages/*\" run build",
    "check": "tsc --noEmit -p tsconfig.json && pnpm -r --filter \"./packages/*\" run check",
    "test": "pnpm build && node --check packages/ui/client.js && node --test test/*.test.mjs && pnpm -r --filter \"./packages/*\" run test",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xi4z/dsh-utils-approval-policy": "0.6.0",
    "@xi4z/dsh-utils-notify": "0.6.0",
    "@xi4z/dsh-utils-ui": "0.6.0",
    "@xi4z/dsh-utils-utils-agents": "0.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.4.0-0"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
