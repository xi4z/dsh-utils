{
  "name": "@xi4z/dsh-utils-utils-agents",
  "version": "0.1.0",
  "description": "dsh-utils component: the utils-agents panel that lists, edits, toggles and syncs the skills and AGENTS.md of ~/.dsh/.agent-presets directories, clones or fast-forwards public and private Git repositories with per-repository or panel-wide Deploy Keys, and copies the shared presets a skill repository carries under .dsh into that home.",
  "license": "MIT",
  "author": "xi4z",
  "homepage": "https://github.com/xi4z/dsh-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xi4z/dsh-utils.git",
    "directory": "packages/utils-agents"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
