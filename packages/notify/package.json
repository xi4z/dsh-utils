{
  "name": "@xi4z/dsh-utils-notify",
  "version": "0.9.1",
  "description": "dsh-utils component: turn-end / approval / question notifications through a Gotify gateway, tagged with the device name.",
  "license": "MIT",
  "author": "xi4z",
  "homepage": "https://github.com/xi4z/dsh-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xi4z/dsh-utils.git",
    "directory": "packages/notify"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
