{
  "name": "@xi4z/dsh-utils-ui",
  "version": "0.9.2",
  "description": "dsh-utils component: the shared browser half — one configuration page for every dsh-utils row and the utils-agents sidebar panel.",
  "license": "MIT",
  "author": "xi4z",
  "homepage": "https://github.com/xi4z/dsh-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xi4z/dsh-utils.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
